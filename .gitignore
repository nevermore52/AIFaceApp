# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Build output
bin/
dist/

# Environment files
.env
.env.local
.claude/
# Logs
*.log
logs/

# Database files
*.db
*.sqlite

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Docker volumes
docker/volumes/

# Uploads directory — real files are excluded, only .gitkeep is tracked
uploads/*
!uploads/.gitkeep

# Temporary files
tmp/
temp/
